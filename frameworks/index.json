{
  "frameworks": [
    {
      "name": "laravel",
      "label": "Laravel",
      "versions": ["13", "12", "11", "10", "9", "8", "7", "6"],
      "latest": "13",
      "detect": [
        {"file": "artisan"},
        {"composer": "laravel/framework"}
      ]
    },
    {
      "name": "lumen",
      "label": "Lumen",
