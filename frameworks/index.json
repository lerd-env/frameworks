      "versions": ["8", "7", "6", "5", "4"],
      "latest": "8",
      "detect": [
        {"file": "symfony.lock"},
        {"composer": "symfony/framework-bundle", "composer_sections": ["flex-require"], "version_key": "extra.symfony.require"}
      ]
    },
    {
      "name": "wordpress",
      "label": "WordPress",
      "versions": ["7", "6", "5"],
      "latest": "7",
